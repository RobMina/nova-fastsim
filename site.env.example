# Copy to site.env (gitignored) and fill for the target host. Missing names fail closed.
# Paths are as the job sees them on that site. Do not commit real values.
#
# Empty KEY= lines are treated as unset (not inserted into the environment).
# Within this file the last occurrence of a key wins; a non-empty process
# environment always wins over the file. Leading "export " and unquoted
# trailing " # comments" are accepted.

# --- bdnmc-nova / generators (public checkouts + private config) ---
BDNMC_NOVA_SRC=
BDNMC_NOVA_CONFIG=
CARD=
GEN_IMAGE=
NOVA_IMAGE=
NOVA_SETUP=
NOVA_FCL=

# --- novafastsim_ldm orchestration ---
NOVAFS_EVENTS_OUT=events.txt
NOVAFS_JOB_HANDLE=nova-fastsim-example
NOVAFS_ENDPOINT=slurm_ssh
NOVAFS_GPUS=1

# --- nova-fastsim ---
NOVA_DEVICE_FLOAT=float64
NOVA_LIBRARY_CACHE=

# --- private inputs bundle (see setup/README.md) ---
# When set, empty BDNMC_NOVA_CONFIG / NOVA_FCL are filled from the files the bundle's
# RELEASE.json marks with role "frame" / "sim_config", after checking the root against
# that manifest. Stub rows (identity frame, NOT the NOvA ND) are used only with
# NOVA_FASTSIM_ALLOW_STUB=1. Otherwise point BDNMC_NOVA_CONFIG at a private frame JSON
# (site-local path or a local copy).
# NOVA_FASTSIM_INPUTS=
# NOVA_FASTSIM_ALLOW_STUB=

# --- hep-endpoints (Slurm-over-SSH; names only — fill locally) ---
# HEPEP_SLURM_HOST=
# HEPEP_SLURM_ACCOUNT=
# HEPEP_SLURM_CPU_PARTITION=
# HEPEP_SLURM_WORKDIR=
