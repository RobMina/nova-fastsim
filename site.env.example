# Copy to site.env (gitignored) and fill for the target host. Missing names fail closed.
# Paths are as the job sees them on that site.

# --- bdnmc-nova / generators (public checkouts + private config) ---
BDNMC_NOVA_SRC=
BDNMC_NOVA_CONFIG=
CARD=
GEN_IMAGE=
NOVA_IMAGE=
NOVA_SETUP=
NOVA_FCL=

# --- novafastsim_ldm orchestration ---
NOVAFS_EVENTS_OUT=events.txt
NOVAFS_JOB_HANDLE=nova-fastsim-example
NOVAFS_ENDPOINT=slurm_ssh
NOVAFS_GPUS=1

# --- nova-fastsim ---
NOVA_DEVICE_FLOAT=float64
NOVA_LIBRARY_CACHE=

# --- private inputs bundle (when a release exists; see setup/README.md) ---
# NOVA_FASTSIM_INPUTS=
